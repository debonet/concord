"use strict";

const { fzMain } = require( "../scripts/concord-init.js" );

process.exitCode = fzMain(
  process.argv.slice( 2 ), process.cwd(),
  ( s ) => process.stdout.write( s ),
  ( s ) => process.stderr.write( s )
);
