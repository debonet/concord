"use strict";

const { fzTree } = require( "../scripts/tree.js" );
const cExit = fzTree(
  process.argv.slice( 2 ),
  process.cwd(),
  ( s ) => process.stdout.write( s ),
  ( s ) => process.stderr.write( s )
);
process.exitCode = cExit;
